# Copy to .env for local dev. In Railway, set these in the service's Variables tab.

# --- Telegram ---
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-token-here
# Channel username (bot must be an admin with "Post Messages" permission)
TELEGRAM_CHANNEL_ID=@ParidhaanCreations

# --- Backend API ---
# Production: https://api.paridhaancreations.xyz/api
# Local dev:  http://localhost:8000/api
API_BASE_URL=https://api.paridhaancreations.xyz/api
# Shared secret between bot and backend for /api/internal/* endpoints.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=change-me-to-a-strong-random-string

# --- Public website ---
WEB_BASE_URL=https://paridhaancreations.xyz

# --- Behaviour ---
LOG_LEVEL=INFO
POLLING_TIMEOUT=30
