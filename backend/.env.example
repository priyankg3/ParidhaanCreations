# Paridhaan Creations backend — environment template
# Copy to backend/.env for local dev, or paste these keys into Railway's
# Variables tab for production. Never commit the real .env file.

# ---- Database ----
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=paridhaan_db

# ---- Payments (Razorpay only; Stripe was removed in Phase 1) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
# Optional, for webhook signature verification:
RAZORPAY_WEBHOOK_SECRET=

# ---- Google OAuth 2.0 ----
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
# Must EXACTLY match one of the Authorized redirect URIs in the Google Cloud
# Console for this client. Example for prod: https://paridhaancreations.xyz/auth/google
GOOGLE_REDIRECT_URI=https://paridhaancreations.xyz/auth/google

# Where to send the user after a successful login (frontend root).
FRONTEND_URL=https://paridhaancreations.xyz
# Set when the frontend and backend share an apex domain (e.g.
# paridhaancreations.xyz + api.paridhaancreations.xyz). Leave blank otherwise.
COOKIE_DOMAIN=.paridhaancreations.xyz

# ---- Admin whitelist ----
# Comma-separated list of emails that get is_admin=True on first Google login.
ADMIN_EMAILS=priyankg3@gmail.com

# ---- Cloudinary (image hosting) ----
CLOUDINARY_CLOUD_NAME=dl5wouk5o
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# ---- Email (Resend) ----
# Phase 1 does not wire Resend in yet — reserved for Phase 1.5 so email
# notifications stop being console-only.
RESEND_API_KEY=
FROM_EMAIL=orders@paridhaancreations.xyz

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Shipping (Shiprocket) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- Telegram (reserved for Phase 4) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@paridhaancreations

# ---- CORS ----
# Comma-separated list of allowed frontend origins. The backend now REFUSES to
# start if this is unset (no more '*' default).
CORS_ORIGINS=https://paridhaancreations.xyz,https://www.paridhaancreations.xyz,http://localhost:3000

# ---- Misc ----
SITE_URL=https://paridhaancreations.xyz
