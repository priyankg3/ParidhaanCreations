# Paridhaan Creations frontend — environment template
# Copy to frontend/.env.local for local dev, or set in Vercel's Environment
# Variables for production. Create React App only reads vars prefixed with
# REACT_APP_ and bakes them into the build at build time.

# URL of the FastAPI backend. In prod this is the api.* subdomain;
# locally it's your uvicorn dev server (default http://localhost:8000).
REACT_APP_BACKEND_URL=https://api.paridhaancreations.xyz
